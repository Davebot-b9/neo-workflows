# Copia este archivo a .env y ajusta los valores. .env nunca se commitea.

POSTGRES_USER=neo
POSTGRES_PASSWORD=neo-dev-password
POSTGRES_DB=neo

# Proveedor opcional Jev (TypeSafe). Si falta, el proveedor "jev" no se activa.
JEV_API_KEY=

# cpu | cuda — compose.gpu.yaml fuerza "cuda".
NEO_MODEL_DEVICE=cpu
