# typescript-eslint@8.72.1 declara typescript ">=4.8.4 <6.1.0" como peer,
# y TypeScript 7.0 (el que usamos para tsc/vite, ver brief) queda fuera de
# ese rango. legacy-peer-deps deja instalar igual. El lint en sí no corre
# todavía por una compuerta aparte de typescript-eslint contra TS7 (ver
# TODO en CLAUDE.md); esto solo evita el ERESOLVE del instalador.
legacy-peer-deps=true
